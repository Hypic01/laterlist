# ---- Production (all required) ----
# DATABASE_URL=postgresql://...          # Supabase: use the Supavisor pooled connection string
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=eyJ...               # also set VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY at build time
# SUPABASE_JWT_SECRET=                   # only for legacy HS256 projects; omit to use JWKS
# OPENROUTER_API_KEY=sk-or-v1-...         # sorting engine (Jev). Missing → falls back to Haiku
# ANTHROPIC_API_KEY=sk-ant-...           # summaries; also sorting when CLASSIFIER=haiku
# Polar (merchant of record). All four required to enable billing; absent =
# upgrade flow disabled. POLAR_SERVER defaults to sandbox — set "production"
# ONLY at go-live.
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=...
# POLAR_PRODUCT_MONTHLY_ID=...
# POLAR_PRODUCT_ANNUAL_ID=...
# POLAR_SERVER=sandbox
# APP_URL=https://your-domain.com
# ADMIN_EMAILS=doldorijw@gmail.com

# ---- Knobs (defaults shown) ----
# PORT=4400
# FREE_VIDEO_CAP=1000
# PRO_VIDEO_CAP=25000
# FREE_SUMMARY_QUOTA=100                 # TL;DRs per calendar month on the free tier
# BUDGET_USD=100
# IMPORTS_PER_HOUR=5
# YOUTUBE_REMOVAL=off                   # off (default), admins, or all; server-side removal kill switch
# CHUNK_SIZE=25
# BATCH_THRESHOLD=500
# CLASSIFY_MODEL=claude-haiku-4-5
# CLASSIFIER=jev                         # or "haiku" to roll back sorting to Claude Haiku
# JEV_MODEL=typesafe/jev-1.13
# JEV_CONCURRENCY=16                     # parallel Jev requests per chunk
# JEV_CHUNK_SIZE=100                     # videos per worker chunk under Jev
# BACKGROUND_BUDGET_MS=40000             # serverless: work per background run (under maxDuration 60 s)
# BACKGROUND_MAX_HOPS=30                 # serverless: hand-offs one job may chain
# CRON_SECRET=...                        # serverless: required for background hand-offs (and the daily cron)
# APP_URL=https://watch-later-web.vercel.app  # hand-offs call this; use the public domain, not a protected preview URL
# BETA_ALLOWLIST=friend@example.com,friend2@example.com
# EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop,ponmlkjihgfedcbaponmlkjihgfedcba
# VITE_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop  # comma separated client IDs are supported

# ---- Local dev (zero accounts needed) ----
# DEV_FAKE_AUTH=1                        # sign in with any email
# FAKE_LLM=1                             # deterministic classification, zero API cost
